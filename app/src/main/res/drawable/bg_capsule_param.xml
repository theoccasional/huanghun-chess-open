<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 参数组 大胶囊（围养圈）：暖金米纸，微投影 + 细描边，圆角大圈。
     只做“底纸区别”：这一组是暖金，其余组各自不同纸张色 —— 用户一眼分群而不需标题。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#301B1205"
                android:centerColor="#1A100A03"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFBF2DC"
                android:centerColor="#FFF8EAC8"
                android:endColor="#FFF4E3BC" />
            <stroke android:width="1dp" android:color="#D9D2A86A" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>