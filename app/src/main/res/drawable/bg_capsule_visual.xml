<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 视觉组 大胶囊（围养圈）：青瓷米纸，微投影 + 细描边，圆角大圈。
     与参数(暖金)/更多(淡檀)纸张色区分 —— 三群各见一套底纸，一眼可辨倾向不同。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#301A2013"
                android:centerColor="#1A120A05"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF4F0DC"
                android:centerColor="#FFEEEFD3"
                android:endColor="#FFE8E9C6" />
            <stroke android:width="1dp" android:color="#D9BFC58A" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>