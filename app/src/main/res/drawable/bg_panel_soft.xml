<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 面板软底：糯象牙轻渐变 + 圆角 + 细金描边，比纯平色块更"有分量"。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFBF0"
        android:endColor="#FFF3D9" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="#33C89B2C" />
</shape>