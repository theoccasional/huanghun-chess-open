<?xml version="1.0" encoding="utf-8"?>
<!-- 黑方鼓型棋子：黑色渐变圆 + 金色描边 + 中心高光 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="60%p"
        android:startColor="#5A5A5A"
        android:centerColor="#1A1A1A"
        android:endColor="#000000" />
    <stroke
        android:width="1.5dp"
        android:color="#FFF3D0" />
    <size
        android:width="40dp"
        android:height="40dp" />
</shape>
