<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 设置弹窗「小胶囊」按钮底：纯白基底 + 大圆角（34~36dp 高的按钮两端全圆成胶囊）。
     backgroundTintList 照旧由全局菜单钮色动态着色（换底不换色、不破换色机制）；
     ripple 层保留按压反馈。仅设置弹窗期间临时套用，关闭时恢复原底，主界面零影响。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF7F2E6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>