<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 深色弹窗：墨色渐变面 + 细青瓷边，替代深胡桃+金边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#262B31"
        android:centerColor="#20242A"
        android:endColor="#1B1E23" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="#592F6B5A" />
</shape>