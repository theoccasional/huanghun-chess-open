<?xml version="1.0" encoding="utf-8"?>
<!-- ★ 游戏结束等深色弹窗：深胡桃底 + 古金描边 + 上部一抹暖光，更高级不刺眼。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3A2F1E"
        android:centerColor="#2A2418"
        android:endColor="#211A12" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#C89B2C" />
</shape>