<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/dialog_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择导出格式，查看棋谱内容，可复制或保存到文件"
        android:textColor="#E8D5A3"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvExportHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="保存到文件会自动生成带时间戳的文件名；复制则直接得到棋谱文字。"
        android:textColor="#9A8F7A"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="导出格式："
            android:textColor="#E8D5A3"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spExportFormat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <EditText
        android:id="@+id/etExportContent"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="13sp"
        android:gravity="top|start"
        android:background="@drawable/edittext_dark_bg"
        android:padding="8dp"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:minLines="6"
        android:maxLines="12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnExportCopy"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="复制到剪贴板"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#7A4B2A" />

        <Button
            android:id="@+id/btnExportSave"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="保存到文件"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:backgroundTint="#5C5040" />

        <Button
            android:id="@+id/btnExportClose"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="关闭"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:backgroundTint="#3A332B" />
    </LinearLayout>

</LinearLayout>