<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════
     ★ 墨玉·青瓷 色板（中性底色 + 单一强调色）
     基调：雾白纸面 + 墨色文字 + 青瓷绿主操作 + 赤陶危险色；
     棋盘保留暖木色作为唯一的“暖”元素，界面 chrome 不再用金色。
     说明：只改"值"，不改任何颜色【名称】，布局/代码引用全部兼容。
     ══════════════════════════════════════════════════════════ -->
<resources>
    <!-- 主色：青瓷绿（低饱和、偏墨，白字对比 6.2:1） -->
    <color name="primary">#2F6B5A</color>
    <color name="primary_dark">#234F43</color>
    <color name="primary_light">#7FB6A4</color>

    <!-- 棋盘：暖木色保留，作为界面里唯一的暖色焦点 -->
    <color name="board_light">#E9C28A</color>
    <color name="board_dark">#A06A2E</color>
    <color name="board_bg">#F4F3EF</color>

    <!-- 文字：墨色，比纯黑柔和，层次更清楚 -->
    <color name="text_primary">#1B1E23</color>
    <color name="text_secondary">#646A71</color>
    <color name="text_dark">#111318</color>

    <!-- 棋子（不参与改色，保持正红正黑） -->
    <color name="piece_red">#D42020</color>
    <color name="piece_black">#1A1A1A</color>

    <!-- 高亮：赤陶选中 / 暖铜上一步，透明度收敛，不糊盘面 -->
    <color name="selected_highlight">#33D24A3F</color>
    <color name="last_move_highlight">#33C8963E</color>
    <color name="legal_move_dot">#33000000</color>

    <!-- Tab：选中青瓷绿，未选雾灰（文字随之转墨色） -->
    <color name="tab_active">#2F6B5A</color>
    <color name="tab_inactive">#E7E9E5</color>
    <color name="tab_bar_bg">@android:color/transparent</color>

    <!-- 面板：透明底保留，描边改为中性雾灰 -->
    <color name="panel_bg">@android:color/transparent</color>
    <color name="panel_border">#DFE3DE</color>

    <!-- 按钮：青瓷主操作 / 竹青次操作 / 赤陶危险 / 灰绿中性 -->
    <color name="btn_primary">#2F6B5A</color>
    <color name="btn_secondary">#4C7F72</color>
    <color name="btn_danger">#B23A2E</color>
    <color name="btn_success">#2F7A50</color>
    <color name="btn_neutral">#66716C</color>
    <color name="btn_neutral_deep">#505A55</color>

    <!-- 顶栏：白面 + 墨字，靠投影与细线与棋盘分层 -->
    <color name="status_bar_bg">#FFFFFF</color>
    <color name="status_bar_text">#1B1E23</color>

    <!-- 解说区域：白纸墨字 -->
    <color name="commentary_bg">#FFFFFF</color>
    <color name="commentary_text">#2A2E33</color>

    <!-- 拖拽抓握条：低存在感中性灰 -->
    <color name="grab_handle_bg">#D6DAD5</color>
</resources>